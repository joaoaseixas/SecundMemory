<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <!-- For IHttpContextAccessor (Identity/CurrentUser.cs) without pulling in the full Web SDK. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- So integration tests can reach ApplicationDbContext.Pages/Blocks (internal:
         Application only sees them through IPageRepository/IBlockRepository). -->
    <InternalsVisibleTo Include="SecundMemory.Infrastructure.IntegrationTests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SecundMemory.Domain\SecundMemory.Domain.csproj" />
    <ProjectReference Include="..\SecundMemory.Application\SecundMemory.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AWSSDK.S3" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <!-- Only ever used when Testing:UseSqlite=true (see DependencyInjection.AddPersistence) — production always uses Npgsql. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <!-- Pin explicitly: the transitive default (2.1.11) has a known high-severity advisory. -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
  </ItemGroup>

</Project>
