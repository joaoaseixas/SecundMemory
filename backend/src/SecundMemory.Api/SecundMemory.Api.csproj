      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="2.4.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SecundMemory.Application\SecundMemory.Application.csproj" />
    <ProjectReference Include="..\SecundMemory.Infrastructure\SecundMemory.Infrastructure.csproj" />
  </ItemGroup>

</Project>
